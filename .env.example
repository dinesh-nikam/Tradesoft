# Development example only. Every value below is a placeholder on the production deny-list
# (07 §3.4 load rule 3): a production process refuses to start with any of them.

# config — validated, loggable
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1
DATABASE_POOL_MAX=20
LOG_LEVEL=info
LOG_SINK=stdout
HTTP_BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_BYTES=20971520
IMPORT_ROOT=data
JOB_CONCURRENCY=4
SCHEDULER_TICK_MS=15000
ANALYTICS_STALENESS_DAILY_SESSIONS=3
RATE_LIMIT_READ_PER_MIN=300
MAIL_FROM=tradesoft-dev@tradesoft.local
MAIL_HOST=localhost
# Production only: 465 is implicit TLS, any other port must offer STARTTLS. MAIL_USER defaults to MAIL_FROM.
MAIL_PORT=587
MAIL_USER=
OTEL_EXPORTER_OTLP_ENDPOINT=

# secrets — validated, never serialised (06 §12.1)
DATABASE_URL=postgres://tradesoft_app:change-me@localhost:5432/tradesoft
MIGRATOR_DATABASE_URL=postgres://tradesoft_migrator:change-me@localhost:5432/tradesoft
JWT_SIGNING_KEY_CURRENT=change-me
JWT_SIGNING_KEY_PREVIOUS=
MFA_ENCRYPTION_KEY=change-me
CURSOR_SECRET=change-me
SMTP_PASSWORD=change-me
OPS_METRICS_TOKEN=change-me
