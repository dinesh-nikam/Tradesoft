{
  "name": "tradesoft",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "static": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test:unit": "vitest run --exclude \"**/*.contract.test.ts\" --exclude \"**/*.integration.test.ts\"",
    "test:contract": "vitest run contract.test",
    "test": "vitest run",
    "test:integration": "vitest run integration.test --no-file-parallelism",
    "db:migrate": "node packages/db/src/migrate-cli.ts",
    "db:seed:dev": "node packages/db/src/seed-dev-cli.ts",
    "db:import:reference": "node packages/db/src/reference-import-cli.ts",
    "build:web": "pnpm --filter @tradesoft/web build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
